@inproceedings{billouard2025snakenerf,
  abbr={ICCVW},
  title={Tile and Slide: A New Framework for Scaling NeRF from Local to Global 3D Earth Observation},
  author={Billouard, Camille and Derksen, Dawa and Constantin, Alexandre and Vallet, Bruno},
  booktitle={Proceedings of the IEEE/CVF International Conference on Computer Vision (ICCV) Workshops},
  month={October},
  year={2025},
  pages={3778--3788},
  abstract={Neural Radiance Fields (NeRF) have recently emerged as a competitive approach for 3D reconstruction from multi-date satellite imagery, but they remain constrained to small scenes because the volume of training rays required to cover larger areas exceeds available memory. We introduce Snake-NeRF, an out-of-core framework that scales NeRF to very large geographic regions on a single GPU. Our approach partitions the area of interest into non-overlapping 3D tiles and processes, at each step, only the pixels and network parameters relevant to the current tile. A novel 2x2 tile progression strategy and a segmented sampler prevent reconstruction artifacts along tile boundaries. The method achieves linear time complexity and introduces no compromise in reconstruction quality.},
  html={https://openaccess.thecvf.com/content/ICCV2025W/3D-VAST/html/Billouard_Tile_and_Slide__A_New_Framework_for_Scaling_NeRF_ICCVW_2025_paper.html},
  pdf={https://openaccess.thecvf.com/content/ICCV2025W/3D-VAST/papers/Billouard_Tile_and_Slide__A_New_Framework_for_Scaling_NeRF_ICCVW_2025_paper.pdf},
  code={https://github.com/Ellimac0/Snake-NeRF},
  bibtex_show={true},
  selected={true}
}


@inproceedings{billouard2024satngp,
  abbr={IGARSS},
  title={SAT-NGP: Unleashing Neural Graphics Primitives for Fast Relightable Transient-Free 3D Reconstruction From Satellite Imagery},
  author={Billouard, Camille and Derksen, Dawa and Sarrazin, Emmanuelle and Vallet, Bruno},
  booktitle={IGARSS 2024 - 2024 IEEE International Geoscience and Remote Sensing Symposium},
  year={2024},
  pages={8749--8753},
  doi={10.1109/IGARSS53475.2024.10641775},
  abstract={Recent work has demonstrated the potential of Neural Radiance Fields (NeRF) for 3D reconstruction from multi-date satellite imagery, with the ability to disentangle lighting and transient objects. However, these neural methods suffer from prohibitive training times of several tens of hours, compared to a few minutes for classical stereo-vision pipelines. We introduce SAT-NGP, which brings together an efficient sampling strategy and multi-resolution hash encoding inspired by Instant Neural Graphics Primitives. Training time is reduced to approximately 15 minutes on a single GPU without any degradation in reconstruction quality, making satellite NeRFs practically usable for the first time.},
  html={https://ieeexplore.ieee.org/document/10641775},
  pdf={https://arxiv.org/pdf/2403.18711},
  code={https://github.com/Ellimac0/SAT-NGP},
  bibtex_show={true},
  selected={true}
}
